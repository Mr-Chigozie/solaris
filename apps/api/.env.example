# ── Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL)
# Local install, managed provider (Neon/Supabase/Render) or `npm run db:local`
DATABASE_URL=postgresql://solaris:solaris@localhost:5432/solaris

# ── Auth — generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Seed: first platform administrator (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@solaris.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
